# Local development (copy to .env)
SECRET_KEY=change-me-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Neon ou local). Sem DATABASE_URL, o projeto usa SQLite.
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Google Cloud Storage for uploads (production)
# GS_BUCKET_NAME=pw26-media-SEU_PROJECT_ID
# GS_QUERYSTRING_AUTH=False

# CSRF (production Cloud Run URL, comma-separated)
# CSRF_TRUSTED_ORIGINS=https://pw26-django-xxxxx.run.app

# AI APIs (optional)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
