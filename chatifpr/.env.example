# Local development (copy to .env)
SECRET_KEY=change-me-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL no Neon (obrigatório). Use a connection string direta do projeto.
DATABASE_URL=postgresql://user:pass@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Google Cloud Storage for uploads (production)
# GS_BUCKET_NAME=chatifpr-media-SEU_PROJECT_ID
# GS_QUERYSTRING_AUTH=False

# CSRF (production Cloud Run URL, comma-separated)
# CSRF_TRUSTED_ORIGINS=https://chatifpr-django-xxxxx.run.app

# AI APIs (optional)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
